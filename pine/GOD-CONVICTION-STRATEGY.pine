// This source code is subject to the terms of the Mozilla Public License 2.0
// © OMNI-GOD ∞ — GOD CONVICTION STRATEGY (backtest twin)
//
// PURPOSE
// ───────
// This is the strategy() twin of the GOD Conviction indicator, built to answer
// ONE question honestly: does the confluence/trap engine have measurable edge?
//
// HONESTY RULES BAKED IN (do not "improve" them away):
//  1. Orders fill at the NEXT bar's open (calc_on_order_fill defaults;
//     process_orders_on_close=false). No close-fill fantasy.
//  2. Commission + slippage are strategy inputs and MUST be set to your broker.
//  3. If SL and TP are both inside one bar's range, TradingView resolves in
//     bar order — treat same-bar results as optimistic.
//  4. No parameter here was optimized on the backtest. Ship defaults only.
//
// FACTOR FAMILIES (same weights as the indicator):
//  T trend-stack (18) · H htf-bias (15) · S liquidity-sweep (25)
//  Z zones: OB tap / beyond-FVG reclaim / iFVG / bait-penalty (22)
//  P premium-discount (8) · O oscillators (8) · D traps (15)
// Entry needs score >= threshold AND >= minFamilies distinct families.
// Beyond-FVG mode blocks entries INSIDE un-reclaimed gaps (bait).
// Cost gate refuses trades whose TP1 can't clear round-trip costs.
// Daily circuit breaker: realized-R loss cap + max trades per day.
//
// SEE docs/BACKTEST_REPORT.md for the out-of-sample verdict before running live.

//@version=6
strategy("GOD Conviction Strategy [Backtest Twin]", shorttitle="GOD-CS",
     overlay=true, pyramiding=0, initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.cash_order, commission_value=2.0,
     slippage=2, process_orders_on_close=false, calc_on_every_tick=false,
     max_labels_count=100, max_boxes_count=100)

// ══════════════════════════════ INPUTS ══════════════════════════════
string G_FAM  = "━━━ FACTOR FAMILIES ━━━"
string G_GATE = "━━━ ENTRY GATES ━━━"
string G_RISK = "━━━ RISK & EXECUTION ━━━"
string G_TRAP = "━━━ TRAP INTELLIGENCE & BEYOND-FVG ━━━"

bool useT = input.bool(true,  "T · Trend stack (18)",            group=G_FAM)
bool useH = input.bool(true,  "H · Higher-TF bias (15)",         group=G_FAM)
bool useS = input.bool(true,  "S · Liquidity sweep / SFP (25)",  group=G_FAM)
bool useZ = input.bool(true,  "Z · Zones: OB / beyond-FVG / iFVG (22)", group=G_FAM)
bool useP = input.bool(true,  "P · Premium / discount (8)",      group=G_FAM)
bool useO = input.bool(true,  "O · Oscillators (8)",             group=G_FAM)
bool useD = input.bool(true,  "D · Traps: SFP + fake breakouts (15)", group=G_FAM)

float threshold   = input.float(70.0, "Confluence threshold",   group=G_GATE, minval=20.0, maxval=95.0)
int   minFamilies = input.int(4,      "Min distinct families",  group=G_GATE, minval=1, maxval=7)
int   swingLen    = input.int(20,     "Swing / liquidity lookback", group=G_GATE, minval=5, maxval=100)
int   zoneMaxAge  = input.int(120,    "Zone max age (bars)",    group=G_GATE, minval=20, maxval=500)

float riskPct    = input.float(1.0, "Risk % per trade",         group=G_RISK, minval=0.1, maxval=5.0, step=0.1)
float slAtrBuf   = input.float(1.0, "SL swing buffer (×ATR)",   group=G_RISK, minval=0.0, step=0.1)
float slCapAtr   = input.float(2.0, "SL cap (×ATR)",            group=G_RISK, minval=0.5, step=0.1)
float tp1RR      = input.float(1.5, "TP1 (R)",                  group=G_RISK, minval=0.5, step=0.25)
float tp2RR      = input.float(3.0, "TP2 (R)",                  group=G_RISK, minval=1.0, step=0.25)
float trailAtr   = input.float(1.2, "Runner trail (×ATR)",      group=G_RISK, minval=0.3, step=0.1)
string htf1      = input.string("240", "HTF 1 timeframe",       group=G_RISK)
string htf2      = input.string("D",   "HTF 2 timeframe",       group=G_RISK)
bool  allowShort = input.bool(true, "Allow shorts",              group=G_RISK)

bool  useBeyondFvg = input.bool(true,  "Beyond-FVG mode (no entries inside gaps)", group=G_TRAP)
bool  useInvFvg    = input.bool(true,  "Trade inverted FVGs",    group=G_TRAP)
bool  blockSusBrk  = input.bool(true,  "Block low-volume breakout lures", group=G_TRAP)
int   trapMemory   = input.int(12,     "Trap memory (bars)",     group=G_TRAP, minval=3, maxval=60)
float sfpVolMult   = input.float(1.15, "SFP volume confirm (×SMA)", group=G_TRAP, step=0.05)
float costBpsRT    = input.float(4.0,  "Round-trip cost (bps) for gate", group=G_TRAP, step=0.5, minval=0.0)
float minNetRR     = input.float(0.6,  "Min net TP1 R after costs", group=G_TRAP, step=0.1, minval=0.0)
bool  useCB        = input.bool(true,  "Circuit breaker",        group=G_TRAP)
float cbDayR       = input.float(3.0,  "Max daily loss (R)",     group=G_TRAP, step=0.5, minval=0.5)
int   cbMaxTrades  = input.int(4,      "Max trades per day",     group=G_TRAP, minval=1, maxval=20)

// ══════════════════════════ CORE INDICATORS ═════════════════════════
float atrV    = ta.atr(14)
float ema9    = ta.ema(close, 9)
float ema21   = ta.ema(close, 21)
float ema50   = ta.ema(close, 50)
float ema200  = ta.ema(close, 200)
float hmaHalf = ta.ema(2 * ta.ema(close, 25) - ema50, 7)
float rsiV    = ta.rsi(close, 14)
float macdL   = ta.ema(close, 12) - ta.ema(close, 26)
float macdH   = macdL - ta.ema(macdL, 9)
float volSma  = ta.sma(volume, 20)
float swingLo = ta.lowest(low, swingLen)[1]    // liquidity resting BELOW (prior bars only)
float swingHi = ta.highest(high, swingLen)[1]  // liquidity resting ABOVE
float rngHi   = ta.highest(close, 100)
float rngLo   = ta.lowest(close, 100)
bool  inDisc  = close <= (rngHi + rngLo) / 2
bool  inPrem  = close >= (rngHi + rngLo) / 2
float s5Lo    = ta.lowest(low, 5)
float s5Hi    = ta.highest(high, 5)

// HTF bias from CLOSED higher-TF bars only (non-repainting)
f_htfBull(string tf) =>
    float c = request.security(syminfo.tickerid, tf, close[1], lookahead=barmerge.lookahead_on)
    float e = request.security(syminfo.tickerid, tf, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
    c > e
bool htf1BullRaw = f_htfBull(htf1)
bool htf2BullRaw = f_htfBull(htf2)
bool htf1Bull = useH ? htf1BullRaw : na
bool htf2Bull = useH ? htf2BullRaw : na

// ═══════════════════════ ZONES: OB / FVG / iFVG ═════════════════════
var array<float> obBullT = array.new<float>()
var array<float> obBullB = array.new<float>()
var array<int>   obBullI = array.new<int>()
var array<float> obBearT = array.new<float>()
var array<float> obBearB = array.new<float>()
var array<int>   obBearI = array.new<int>()
var array<float> fvgBullT = array.new<float>()
var array<float> fvgBullB = array.new<float>()
var array<int>   fvgBullI = array.new<int>()
var array<float> fvgBearT = array.new<float>()
var array<float> fvgBearB = array.new<float>()
var array<int>   fvgBearI = array.new<int>()
var array<float> ifvgSupT = array.new<float>()
var array<float> ifvgSupB = array.new<float>()
var array<int>   ifvgSupI = array.new<int>()
var array<float> ifvgDemT = array.new<float>()
var array<float> ifvgDemB = array.new<float>()
var array<int>   ifvgDemI = array.new<int>()

// impulse → order block (the prior bar's body becomes the zone)
bool bullImp = (close[1] - open[1]) > 1.2 * atrV and close[1] > high[2] and close[2] < open[2]
bool bearImp = (open[1] - close[1]) > 1.2 * atrV and close[1] < low[2] and close[2] > open[2]
if bullImp
    array.push(obBullT, high[1])
    array.push(obBullB, low[1])
    array.push(obBullI, bar_index)
    if array.size(obBullT) > 5
        array.shift(obBullT)
        array.shift(obBullB)
        array.shift(obBullI)
if bearImp
    array.push(obBearT, low[1])
    array.push(obBearB, high[1])
    array.push(obBearI, bar_index)
    if array.size(obBearT) > 5
        array.shift(obBearT)
        array.shift(obBearB)
        array.shift(obBearI)

// fair value gaps
float fvgMin = 0.2 * atrV
if low > high[2] and (low - high[2]) >= fvgMin
    array.push(fvgBullT, low)
    array.push(fvgBullB, high[2])
    array.push(fvgBullI, bar_index)
    if array.size(fvgBullT) > 5
        array.shift(fvgBullT)
        array.shift(fvgBullB)
        array.shift(fvgBullI)
if high < low[2] and (low[2] - high) >= fvgMin
    array.push(fvgBearT, low[2])
    array.push(fvgBearB, high)
    array.push(fvgBearI, bar_index)
    if array.size(fvgBearT) > 5
        array.shift(fvgBearT)
        array.shift(fvgBearB)
        array.shift(fvgBearI)

bool obBullHit = false
bool obBearHit = false
bool ifvgSupTest = false
bool ifvgDemTest = false
bool ifvgFlipSup = false
bool ifvgFlipDem = false

if array.size(obBullT) > 0
    for i = array.size(obBullT) - 1 to 0 by -1
        if low <= array.get(obBullT, i) and close >= array.get(obBullB, i)
            obBullHit := true
        if close < array.get(obBullB, i) or bar_index - array.get(obBullI, i) > zoneMaxAge
            array.remove(obBullT, i)
            array.remove(obBullB, i)
            array.remove(obBullI, i)
if array.size(obBearT) > 0
    for i = array.size(obBearT) - 1 to 0 by -1
        if high >= array.get(obBearB, i) and close <= array.get(obBearT, i)
            obBearHit := true
        if close > array.get(obBearT, i) or bar_index - array.get(obBearI, i) > zoneMaxAge
            array.remove(obBearT, i)
            array.remove(obBearB, i)
            array.remove(obBearI, i)
if array.size(fvgBullT) > 0
    for i = array.size(fvgBullT) - 1 to 0 by -1
        float t = array.get(fvgBullT, i)
        float b = array.get(fvgBullB, i)
        bool failed = close < b
        if failed or bar_index - array.get(fvgBullI, i) > zoneMaxAge
            array.remove(fvgBullT, i)
            array.remove(fvgBullB, i)
            array.remove(fvgBullI, i)
            if useInvFvg and failed
                ifvgFlipSup := true
                array.push(ifvgSupT, t)
                array.push(ifvgSupB, b)
                array.push(ifvgSupI, bar_index)
                if array.size(ifvgSupT) > 4
                    array.shift(ifvgSupT)
                    array.shift(ifvgSupB)
                    array.shift(ifvgSupI)
if array.size(fvgBearT) > 0
    for i = array.size(fvgBearT) - 1 to 0 by -1
        float t = array.get(fvgBearT, i)
        float b = array.get(fvgBearB, i)
        bool failed = close > t
        if failed or bar_index - array.get(fvgBearI, i) > zoneMaxAge
            array.remove(fvgBearT, i)
            array.remove(fvgBearB, i)
            array.remove(fvgBearI, i)
            if useInvFvg and failed
                ifvgFlipDem := true
                array.push(ifvgDemT, t)
                array.push(ifvgDemB, b)
                array.push(ifvgDemI, bar_index)
                if array.size(ifvgDemT) > 4
                    array.shift(ifvgDemT)
                    array.shift(ifvgDemB)
                    array.shift(ifvgDemI)
if array.size(ifvgSupT) > 0
    for i = array.size(ifvgSupT) - 1 to 0 by -1
        if high >= array.get(ifvgSupB, i) and close <= array.get(ifvgSupT, i) and close <= open
            ifvgSupTest := true
        if close > array.get(ifvgSupT, i) or bar_index - array.get(ifvgSupI, i) > zoneMaxAge
            array.remove(ifvgSupT, i)
            array.remove(ifvgSupB, i)
            array.remove(ifvgSupI, i)
if array.size(ifvgDemT) > 0
    for i = array.size(ifvgDemT) - 1 to 0 by -1
        if low <= array.get(ifvgDemT, i) and close >= array.get(ifvgDemB, i) and close >= open
            ifvgDemTest := true
        if close < array.get(ifvgDemB, i) or bar_index - array.get(ifvgDemI, i) > zoneMaxAge
            array.remove(ifvgDemT, i)
            array.remove(ifvgDemB, i)
            array.remove(ifvgDemI, i)

// ═══════════════ BEYOND-FVG STATE MACHINE & TRAPS ═══════════════════
var int   bfgState = 0
var float bfgBot = na
var float bfgTop = na
var int   bfgBar = 0
var int   rfgState = 0
var float rfgTop = na
var float rfgBot = na
var int   rfgBar = 0
if useZ
    if array.size(fvgBullT) > 0
        for i = 0 to array.size(fvgBullT) - 1
            float t = array.get(fvgBullT, i)
            float b = array.get(fvgBullB, i)
            if bfgState == 0 and low < b and close > b
                bfgState := 2
                bfgBot := b
                bfgTop := t
                bfgBar := bar_index
            else if bfgState == 0 and close < b
                bfgState := 1
                bfgBot := b
                bfgTop := t
                bfgBar := bar_index
    if bfgState == 1 and close > bfgBot
        bfgState := 2
        bfgBar := bar_index
    if bfgState > 0 and bar_index - bfgBar > trapMemory
        bfgState := 0
    if array.size(fvgBearT) > 0
        for i = 0 to array.size(fvgBearT) - 1
            float t = array.get(fvgBearT, i)
            float b = array.get(fvgBearB, i)
            if rfgState == 0 and high > t and close < t
                rfgState := 2
                rfgTop := t
                rfgBot := b
                rfgBar := bar_index
            else if rfgState == 0 and close > t
                rfgState := 1
                rfgTop := t
                rfgBot := b
                rfgBar := bar_index
    if rfgState == 1 and close < rfgTop
        rfgState := 2
        rfgBar := bar_index
    if rfgState > 0 and bar_index - rfgBar > trapMemory
        rfgState := 0

bool insideBullFvg = false
bool insideBearFvg = false
if array.size(fvgBullT) > 0
    for i = 0 to array.size(fvgBullT) - 1
        if close >= array.get(fvgBullB, i) and close <= array.get(fvgBullT, i)
            insideBullFvg := true
if array.size(fvgBearT) > 0
    for i = 0 to array.size(fvgBearT) - 1
        if close >= array.get(fvgBearB, i) and close <= array.get(fvgBearT, i)
            insideBearFvg := true
bool baitLong  = useBeyondFvg and insideBullFvg and bfgState != 2
bool baitShort = useBeyondFvg and insideBearFvg and rfgState != 2

// sweeps & swing-failure traps
bool sslSweep = not na(swingLo) and low < swingLo and close > swingLo and close > open
bool bslSweep = not na(swingHi) and high > swingHi and close < swingHi and close < open
bool volConf  = not na(volSma) and volume > volSma * sfpVolMult
var int bullTrapBar = 0
var int bearTrapBar = 0
if useD and bslSweep and volConf
    bullTrapBar := bar_index
if useD and sslSweep and volConf
    bearTrapBar := bar_index
// fake breakout: close-break of the swing, then fail back inside
var int   brkUpBar = 0
var float brkUpLvl = na
var int   brkDnBar = 0
var float brkDnLvl = na
if not na(swingHi) and close > swingHi and close[1] <= swingHi
    brkUpBar := bar_index
    brkUpLvl := swingHi
if not na(swingLo) and close < swingLo and close[1] >= swingLo
    brkDnBar := bar_index
    brkDnLvl := swingLo
if bar_index - brkUpBar <= 6 and not na(brkUpLvl) and close < brkUpLvl
    bullTrapBar := bar_index
    brkUpBar := 0
if bar_index - brkDnBar <= 6 and not na(brkDnLvl) and close > brkDnLvl
    bearTrapBar := bar_index
    brkDnBar := 0
bool bullTrapActive = useD and bar_index - bullTrapBar <= trapMemory
bool bearTrapActive = useD and bar_index - bearTrapBar <= trapMemory
bool brkUpSus = blockSusBrk and bar_index == brkUpBar and not na(volSma) and volume < volSma
bool brkDnSus = blockSusBrk and bar_index == brkDnBar and not na(volSma) and volume < volSma

// ═══════════════════════════ SCORING ════════════════════════════════
float bs = 0.0
float ss = 0.0
int fb = 0
int fs = 0
if useT
    float tb = (ema9 > ema21 and ema21 > ema50 and close > ema200 ? 12.0 : 0.0) + (close > hmaHalf ? 6.0 : 0.0)
    float ts = (ema9 < ema21 and ema21 < ema50 and close < ema200 ? 12.0 : 0.0) + (close < hmaHalf ? 6.0 : 0.0)
    bs += tb
    ss += ts
    fb += tb > 0 ? 1 : 0
    fs += ts > 0 ? 1 : 0
if useH and not na(htf1Bull)
    float hb = (htf1Bull ? 8.0 : 0.0) + (htf2Bull ? 7.0 : 0.0)
    float hs = (not htf1Bull ? 8.0 : 0.0) + (not htf2Bull ? 7.0 : 0.0)
    bs += math.min(hb, 15.0)
    ss += math.min(hs, 15.0)
    fb += hb > 0 ? 1 : 0
    fs += hs > 0 ? 1 : 0
if useS
    bool volImb = not na(volSma) and volume > volSma * 2.0
    if sslSweep
        bs += volImb ? 25.0 : 18.0
        fb += 1
    if bslSweep
        ss += volImb ? 25.0 : 18.0
        fs += 1
if useZ
    if obBullHit
        bs += 12.0
        fb += 1
    if obBearHit
        ss += 12.0
        fs += 1
    if bfgState == 2
        bs += close > bfgTop ? 15.0 : 11.0
        fb += 1
    else if baitLong
        bs -= 8.0
    if rfgState == 2
        ss += close < rfgBot ? 15.0 : 11.0
        fs += 1
    else if baitShort
        ss -= 8.0
    if ifvgDemTest
        bs += 6.0
        fb += 1
    if ifvgSupTest
        ss += 6.0
        fs += 1
if useP
    if inDisc
        bs += 8.0
        fb += 1
    if inPrem
        ss += 8.0
        fs += 1
if useO
    float ob = (macdH > 0 ? 4.0 : 0.0) + (macdH > 0 and macdH[1] <= 0 ? 4.0 : rsiV < 45 and rsiV > rsiV[1] ? 2.0 : 0.0)
    float osx = (macdH < 0 ? 4.0 : 0.0) + (macdH < 0 and macdH[1] >= 0 ? 4.0 : rsiV > 55 and rsiV < rsiV[1] ? 2.0 : 0.0)
    bs += math.min(ob, 8.0)
    ss += math.min(osx, 8.0)
    fb += ob > 0 ? 1 : 0
    fs += osx > 0 ? 1 : 0
if useD
    if bearTrapActive
        bs += 12.0
        fb += 1
    if bullTrapActive
        ss += 12.0
        fs += 1
bs := math.max(0.0, math.min(100.0, bs))
ss := math.max(0.0, math.min(100.0, ss))

// ═════════════════ CIRCUIT BREAKER & COST GATE ══════════════════════
var float dayR = 0.0
var int   tradesToday = 0
var int   cbDay = 0
if dayofmonth != cbDay
    cbDay := dayofmonth
    dayR := 0.0
    tradesToday := 0
bool cbHalt = useCB and (dayR <= -math.abs(cbDayR) or tradesToday >= cbMaxTrades)

float costPx = close * costBpsRT / 10000.0
float pSlL   = math.max(s5Lo - slAtrBuf * atrV, close - slCapAtr * atrV)
float pRkL   = math.max(close - pSlL, 0.0)
float pSlS   = math.min(s5Hi + slAtrBuf * atrV, close + slCapAtr * atrV)
float pRkS   = math.max(pSlS - close, 0.0)
bool costOkL = pRkL >= costPx * 2 and tp1RR - costPx / math.max(pRkL, 1e-9) >= minNetRR
bool costOkS = pRkS >= costPx * 2 and tp1RR - costPx / math.max(pRkS, 1e-9) >= minNetRR

// ═══════════════════════════ ENTRIES ════════════════════════════════
bool buyOk  = bs >= threshold and fb >= minFamilies and not baitLong and not brkUpSus and costOkL
bool sellOk = allowShort and ss >= threshold and fs >= minFamilies and not baitShort and not brkDnSus and costOkS
if cbHalt or strategy.position_size != 0
    buyOk := false
    sellOk := false
if buyOk and sellOk
    if bs >= ss + 5.0
        sellOk := false
    else if ss >= bs + 5.0
        buyOk := false
    else
        buyOk := false
        sellOk := false

if buyOk
    float sl = math.max(s5Lo - slAtrBuf * atrV, close - slCapAtr * atrV)
    float rk = close - sl
    float qty = strategy.equity * (riskPct / 100.0) / rk
    strategy.entry("L", strategy.long, qty=qty)
    strategy.exit("L-x", "L", stop=sl, limit=close + rk * tp2RR)
    strategy.exit("L-tp1", "L", qty_percent=50, limit=close + rk * tp1RR)
    tradesToday += 1
if sellOk
    float sl = math.min(s5Hi + slAtrBuf * atrV, close + slCapAtr * atrV)
    float rk = sl - close
    float qty = strategy.equity * (riskPct / 100.0) / rk
    strategy.entry("S", strategy.short, qty=qty)
    strategy.exit("S-x", "S", stop=sl, limit=close - rk * tp2RR)
    strategy.exit("S-tp1", "S", qty_percent=50, limit=close - rk * tp1RR)
    tradesToday += 1

// ══════════════════ POSITION MANAGEMENT ═════════════════════════════
var float entryPx = na
var float stopPx = na
var float riskD = na
var bool  tp1Done = false
var float peakR = 0.0
bool posLong  = strategy.position_size > 0
bool posShort = strategy.position_size < 0
bool posFlat  = strategy.position_size == 0

// detect fresh fill
if posLong and strategy.position_size[1] <= 0
    entryPx := strategy.position_avg_price
    stopPx := math.max(s5Lo - slAtrBuf * atrV, entryPx - slCapAtr * atrV)
    riskD := entryPx - stopPx
    tp1Done := false
    peakR := 0.0
if posShort and strategy.position_size[1] >= 0
    entryPx := strategy.position_avg_price
    stopPx := math.min(s5Hi + slAtrBuf * atrV, entryPx + slCapAtr * atrV)
    riskD := stopPx - entryPx
    tp1Done := false
    peakR := 0.0

if posLong or posShort
    int dir = posLong ? 1 : -1
    float curR = (close - entryPx) * dir / math.max(riskD, 1e-9)
    peakR := math.max(peakR, curR)
    // TP1 hit → half off, stop to BE
    if not tp1Done and ((posLong and high >= entryPx + riskD * tp1RR) or (posShort and low <= entryPx - riskD * tp1RR))
        tp1Done := true
        stopPx := entryPx
    if tp1Done
        if peakR >= 1.5
            float lock = entryPx + dir * (peakR - 0.5) * riskD
            stopPx := dir == 1 ? math.max(stopPx, lock) : math.min(stopPx, lock)
        else
            float trail = close - dir * trailAtr * atrV
            stopPx := dir == 1 ? math.max(stopPx, trail) : math.min(stopPx, trail)
    if posLong
        strategy.exit("L-x", "L", stop=stopPx, limit=entryPx + riskD * tp2RR)
    if posShort
        strategy.exit("S-x", "S", stop=stopPx, limit=entryPx - riskD * tp2RR)

// realized-R accounting for the circuit breaker (close-based approximation)
if posFlat and strategy.position_size[1] != 0 and not na(riskD) and riskD > 0
    int pdir = strategy.position_size[1] > 0 ? 1 : -1
    float exitR = (close - entryPx) * pdir / riskD
    dayR += exitR

// ══════════════════════════════ PLOTS ═══════════════════════════════
plotshape(buyOk,  "Signal L", shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.tiny)
plotshape(sellOk, "Signal S", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.tiny)
plotshape(ifvgFlipSup, "iFVG supply", shape.diamond, location.abovebar, color.new(color.orange, 20), size=size.tiny)
plotshape(ifvgFlipDem, "iFVG demand", shape.diamond, location.belowbar, color.new(color.aqua, 20),   size=size.tiny)
bgcolor(baitLong ? color.new(color.orange, 92) : baitShort ? color.new(color.orange, 92) : na, title="Inside-gap bait")
